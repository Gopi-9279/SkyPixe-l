PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas URI (or fallback to local / memory in development)
MONGODB_URI=mongodb://127.0.0.1:27017/skypixel

# JWT Authentication
JWT_SECRET=skypixel_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary Credentials (Optional for local dev, needed for live media uploads)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=your_api_secret

# Notification Email (Optional for dev, logs to console if not configured)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=studio@skypixel.com
EMAIL_PASS=your_app_password
EMAIL_TO=admin@skypixel.com

# Instagram Graph API — Long-Lived Access Token (60-day)
# 1. Create a Meta/Facebook App at https://developers.facebook.com
# 2. Add Instagram Graph API product
# 3. Generate a User Token with instagram_basic scope
# 4. Exchange for a long-lived token (60 days)
# 5. Paste the long-lived token below
INSTAGRAM_ACCESS_TOKEN=your_instagram_long_lived_token
